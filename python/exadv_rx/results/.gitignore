# Small, reviewable experiment evidence only. Rules here override root defaults.
# Compatibility location for explicit --output; default/history use python/experiments.
*
!*/
!.gitignore
!*.md
!*.summary.json
!*.summary.txt
!*.summary.csv
!*.metrics.csv
!*.config.json
!*.manifest.json
!*.manifest.example.json
!*.payload_validation.json
!*.events.jsonl
!*.commands.jsonl
!*.hackrf.log
!*.board.log


# Preserve reproducible experiment evidence, including complete decoded streams.
# Scoped to this results directory; repository-wide JSON/CSV rules are unchanged.
!*.json
!*.csv
!*.jsonl
!*.log

# Raw IQ, caches and transient files require external storage, not Git.
*.ci8
*.cf32
*.iq
__pycache__/
*.py[cod]
*.lock
*.tmp
.writing-*
