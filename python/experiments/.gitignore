# Traverse session/phase/replay directories, but only retain reviewable evidence.
*
!*/
!.gitignore
!*.md
!*.summary.json
!*.summary.txt
!*.summary.csv
!*.metrics.csv
!*.validation.csv
!*.sweep.csv
!*.qc.csv
!*.control.tasks.csv
!*.config.json
!*.manifest.json
!*.payload_validation.json
!*.board.log
!*.hackrf.log
!*.events.jsonl
!*.commands.jsonl
!*.packets.sample.jsonl
!*.png
!*.pdf
!index.csv
!runs.csv
!artifacts.csv


# Preserve reproducible experiment evidence, including complete decoded streams.
# Scoped to this results directory; repository-wide JSON/CSV rules are unchanged.
!*.json
!*.csv
!*.jsonl
!*.log

# Raw IQ, caches and transient files require external storage, not Git.
*.ci8
*.cf32
*.iq
__pycache__/
*.py[cod]
*.lock
*.tmp
.writing-*
