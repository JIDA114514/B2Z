# Python / local build caches
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
.Xil/

# Preserve existing defaults outside experiment directories.
*.json
*.csv

# Existing performance experiments: retain structured records.
!/python/perf_test/*.json
!/python/perf_test/*.csv
!/python/perf_test/results/*.json
!/python/perf_test/results/*.csv

# Raw SDR recordings stay outside normal Git history.
# python/experiments/.gitignore selects reviewable nested experiment artifacts.
*.ci8
*.cf32
*.iq

# LaTeX build artifacts
paper/build/
paper/zh/build/
build/
*.aux
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.synctex.gz
*.xdv

# custom configuration

.vscode/settings.json
/doc/framework

*.str
*.log

# Pre-registered N3/UC1 analysis policies & manifests (not generated receiver output).
!/python/control_match/configs/n3_*.json
!/python/control_match/configs/uc1_*.json

# paper template

/ITCA_Templates
